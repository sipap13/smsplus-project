@startuml
left to right direction
skinparam monochrome true
skinparam dpi 150

actor "Analyste Opérationnel" as AO
actor "Analyste d'affaires" as AA
actor "Administrateur" as Admin
actor "Système MMG/OCC" as MMG <<system>>

rectangle "VAS Analytics System" {
  usecase UC1 as "Importer CDR"
  usecase UC2 as "Valider CDR"
  usecase UC3 as "Transformer données (ETL)"
  usecase UC4 as "Gérer CDR"
  usecase UC5 as "Réconciliation CDR"
  usecase UC6 as "Détecter anomalies"
  usecase UC7 as "Calculer KPI VAS"
  usecase UC8 as "Gérer utilisateurs"
  usecase UC9 as "Configurer sources données"
  usecase UC10 as "Consulter dashboard"
  usecase UC11 as "Filtrer données"
  usecase UC12 as "Visualiser statistiques"

  usecase M1 as "Event Count"
  usecase M2 as "Event Duration"
  usecase M3 as "Data Volume"
  usecase M4 as "Charge Amount"
}

AO --> UC1
AO --> UC10
AA --> UC4
AA --> UC5
AA --> UC6
AA --> UC7
Admin --> UC8
Admin --> UC9
MMG --> UC1
Admin --> UC7

UC1 .> UC2 : <<include>>
UC2 .> UC3 : <<include>>
UC3 .> UC4 : <<include>>

UC10 --> UC11
UC10 --> UC12

UC7 .> M1 : <<include>>
UC7 .> M2 : <<include>>
UC7 .> M3 : <<include>>
UC7 .> M4 : <<include>>

note bottom of MMG
  Système source des CDR (MMG / OCC)
end note

@enduml
