# Instructions (FR):
# 1) Copier/renommer ce fichier en `.env` à la racine du projet.
# 2) Remplir les clés API et mots de passe (ex: `GROQ_API_KEY`, `MAIL_PASSWORD`).
# 3) Lancer le projet avec : `docker compose up --build`.
#
# La base de données PostgreSQL est provisionnée par Docker Compose :
# - Type : PostgreSQL 16
# - Nom : smsplus
# - Utilisateur : postgres
# - Mot de passe : postgres
# - Port exposé localement : 5432
# - Volume de persistance : smsplus_pgdata
#
# L'API Laravel exécute automatiquement les migrations au démarrage
# via `php artisan migrate --force`, donc aucune importation SQL manuelle
# n'est nécessaire.

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Database
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=smsplus
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Mail / third-party placeholders (remplir si nécessaire)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=admin@example.com
MAIL_FROM_NAME="SMSPlus"

# Example: keys used by docker-compose or services
GROQ_API_KEY=
OTHER_API_KEY=
# Variables d'environnement Docker Compose
# Ce fichier est lu automatiquement par docker compose pour résoudre les ${VAR} dans docker-compose.yml
# Renommez ce fichier en .env et remplissez les valeurs avec vos propres clés.

GROQ_API_KEY=votre_cle_api_groq_ici
GEMINI_API_KEY=votre_cle_api_gemini_ici
MAIL_PASSWORD=votre_mot_de_passe_app_mail_ici
